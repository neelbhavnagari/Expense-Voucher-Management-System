# ==============================================================================
# EXPENSE VOUCHER MANAGEMENT SYSTEM (EVM) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Leave as default or set custom URI. An in-memory MongoDB will automatically start if offline!
MONGODB_URI=mongodb://127.0.0.1:27017/evm_system

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_prachay_evm_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Optional: Force in-memory database mode ('true' or 'false')
USE_MEMORY_DB=true

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=ABC EVM System
